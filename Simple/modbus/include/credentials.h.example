#pragma once

/* Copy to credentials.h and fill in. credentials.h is not committed. */

/* Internet WiFi (phone hotspot) that the master joins to reach the VPS. */
#define WIFI_SSID "network name"
#define WIFI_PASSWORD "password"

/* The master's own access point for the Modbus network. At least 8 characters. */
#define MODBUS_AP_SSID "aitsm-modbus"
#define MODBUS_AP_PASSWORD "change me"

/* MQTT broker on the VPS (TLS). The user may only publish the gateway's topics. */
#define MQTT_HOST "aitsm.vps.webdock.cloud"
#define MQTT_PORT 8883
#define MQTT_USER "esp32_gateway"
#define MQTT_PASSWORD "password"
