menu "AITSM data transmission"

choice AITSM_TRANSMISSION_MODE
	prompt "Transmission mode"
	default AITSM_TRANSMISSION_BATCH
	help
		Select whether measurements are sent one at a time or collected
		in a fixed-size batch before transmission.

	config AITSM_TRANSMISSION_SINGLE
		bool "Single measurement per MQTT message"

	config AITSM_TRANSMISSION_BATCH
		bool "Batch measurements before MQTT transmission"

endchoice

config AITSM_MEASUREMENT_INTERVAL_SECONDS
	int "Measurement interval in seconds"
	range 5 15
	default 15
	help
		Interval used by the measurement producer. The allowed range follows
		the project requirement; MQTT transmission may happen less often
		when batching is selected.

config AITSM_BATCH_INTERVAL_SECONDS
	int "Batch transmission interval in seconds"
	range 1 3600
	default 300
	depends on AITSM_TRANSMISSION_BATCH
	help
		Maximum time from the first measurement in a batch until the batch
		is ready for transmission.

config AITSM_BATCH_MAX_SAMPLES
	int "Maximum measurements per batch"
	range 1 32
	default 20
	depends on AITSM_TRANSMISSION_BATCH
	help
		Fixed upper bound for the in-memory measurement buffer. With the
		default values, 20 measurements represent five minutes at 15-second
		measurement intervals.

config AITSM_TRANSMISSION_PAYLOAD_SIZE
	int "Maximum telemetry payload size"
	range 256 4096
	default 2048
	help
		Maximum number of bytes reserved for a serialized telemetry
		payload. The fixed limit prevents unbounded memory use.

endmenu

menu "AITSM SparkplugB"

config AITSM_SPARKPLUG_GROUP_ID
	string "Sparkplug B group ID"
	default "aitsm"
	help
		Group ID in the topic namespace spBv1.0/<group_id>/<message_type>/<edge_node_id>.

config AITSM_SPARKPLUG_EDGE_NODE_ID
	string "Sparkplug B edge node ID"
	default "thingy91x"
	help
		Edge node ID in the topic namespace. Also used as the device identity
		in the cloud.

endmenu

menu "AITSM MQTT worker"

config AITSM_MQTT_WORKQUEUE_STACK_SIZE
	int "MQTT workqueue stack size"
	range 2048 16384
	default 4096
	help
		Stack reserved for blocking MQTT connect and publish operations.

config AITSM_MQTT_WORKQUEUE_PRIORITY
	int "MQTT workqueue priority"
	range 0 14
	default 5
	help
		Preemptible priority of the dedicated MQTT workqueue.

config AITSM_MQTT_RECONNECT_INITIAL_DELAY_SECONDS
	int "Initial MQTT reconnect delay"
	range 1 3600
	default 5

config AITSM_MQTT_RECONNECT_MAX_DELAY_SECONDS
	int "Maximum MQTT reconnect delay"
	range 1 3600
	default 60

config AITSM_MQTT_PUBACK_TIMEOUT_SECONDS
	int "Initial wait for broker PUBACK"
	range 1 3600
	default 30
	help
		Only a missing PUBACK triggers retransmission of the same MQTT 3.1.1
		payload and message identifier, without creating a new TLS connection.

config AITSM_MQTT_PUBACK_MAX_DELAY_SECONDS
	int "Maximum delay between missing-PUBACK retries"
	range 1 3600
	default 300
	help
		Double the wait after each retransmission up to this bound. ACK and
		disconnect cancel the timer; new samples never change its deadline.

endmenu

menu "AITSM logging"

config AITSM_LOG_LEVEL
	int "AITSM firmware log level"
	range 0 4
	default 3
	help
		Default log level for the AITSM modules: 0 = off, 1 = error,
		2 = warning, 3 = info, 4 = debug. Use 4 locally to see
		verbose debug output, for example LTE mode updates.

endmenu

source "Kconfig.zephyr"
